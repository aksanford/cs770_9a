# Data (survey exports, raw/processed files)
# Ignore everything inside data/, but keep the folder itself via .gitkeep
data/*
!data/.gitkeep

# All CSV files
*.csv

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# Quarto render output (regenerated on every render)
.quarto/
*_files/
scripts/*.html

# R (keep the .Rproj file; ignore per-user RStudio state)
.Rhistory
.RData
.Ruserdata
.Rproj.user/
